# Optional settings for the RentEase API. Copy this file to .env to change them.
# Never commit .env.

# Where the API listens (the React dev server forwards /api here).
PORT=8000

# Supabase: Project Settings > Database > Connection string (URI, Session pooler).
# Leave DATABASE_URL out to use a local SQLite file (backend/rentease.sqlite3) instead.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Sites allowed to send requests that change data (the React dev server).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Set to 1 when deployed behind a proxy (most hosting platforms), so sign-in limits
# count each visitor's real address.
TRUST_PROXY=0

# Email verification. New accounts must open a link emailed to them before they can sign in.
# Without RESEND_API_KEY, emails are printed in the server log instead of sent (fine for local testing).
# Get a key at https://resend.com (API Keys).
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender address. Resend's test address only delivers to the email you signed up to Resend with;
# to email anyone, verify your own domain in Resend and use an address on it.
# EMAIL_FROM=RentEase <onboarding@resend.dev>
# The site's address, used in the links. Filled in automatically on Render.
# APP_URL=http://localhost:5173
