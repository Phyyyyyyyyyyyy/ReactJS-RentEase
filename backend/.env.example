# Optional settings for the RentEase API. Copy this file to .env to change them.
# Never commit .env.

# Where the API listens (the React dev server forwards /api here).
PORT=8000

# Supabase: Project Settings > Database > Connection string (URI, Session pooler).
# Leave DATABASE_URL out to use a local SQLite file (backend/rentease.sqlite3) instead.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Sites allowed to send requests that change data (the React dev server).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
