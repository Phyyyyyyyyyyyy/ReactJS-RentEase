# Optional settings for the RentEase API. Copy this file to .env to change them.
# Never commit .env.

# true adds the error message to "500 server error" responses while developing.
# Keep it false (the default) on the live site.
DEBUG=false

# Where the API listens (the React dev server forwards /api here).
PORT=8000

# For Supabase, copy the PostgreSQL URI from Connect > Session pooler.
# Use your database password and percent-encode reserved characters such as @ (%40).
# Leave DATABASE_URL unset to use backend/rentease.sqlite3.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Sites allowed to send requests that change data (the React dev server).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Set to 1 when deployed behind a proxy (most hosting platforms), so sign-in limits
# count each visitor's real address.
TRUST_PROXY=0

# Admin account to create (or recover) on every start. Useful where there is no shell,
# like Render's free plan. If the account exists, its password is set to ADMIN_PASSWORD.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-strong-password
