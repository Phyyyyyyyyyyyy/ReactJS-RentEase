# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase: Project Settings > Database > Connection string (URI, Session pooler)
# Leave DATABASE_URL out to use a local SQLite file (db.sqlite3) instead.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Origins of the React dev server (Vite) allowed to send requests with the CSRF token.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
