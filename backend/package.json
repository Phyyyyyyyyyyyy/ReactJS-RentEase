{
  "name": "rentease-backend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "RentEase JSON API (Node.js + Express). The React app in ../frontend talks to it under /api.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "db:check": "node scripts/db-check.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  }
}
